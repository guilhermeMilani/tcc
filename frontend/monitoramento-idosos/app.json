      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E75B6",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "20604561-a87b-4af8-a84d-ace4c95cc9fc"
      }
    }
  }
